# Optional comma-separated list of public Invidious instances.
# Example: https://inv.nadeko.net,https://invidious.nerdvpn.de
INVIDIOUS_INSTANCES=

# Optional Google OAuth for read-only YouTube account subscriptions.
# Create a Web application OAuth client in Google Cloud and keep the client secret private.
HF_GOOGLE_CLIENT_ID=
HF_GOOGLE_CLIENT_SECRET=

# Random secret used to encrypt the HttpOnly Google session cookie (32+ characters).
HF_AUTH_SECRET=

# Exact public base URL of this deployment, without a trailing slash.
# Example: https://your-custom-domain.example
NEXT_PUBLIC_APP_URL=
